{
  "name": "gorb",
  "private": true,
  "version": "1.0.0",
  "description": "GorbOS, the $GORB desktop, built with React, TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "nft:keypair": "tsx scripts/nft/generate-keypair.ts",
    "nft:upload": "tsx scripts/nft/upload-assets.ts",
    "nft:deploy": "tsx scripts/nft/deploy-candy-machines.ts",
    "nft:set-payout": "tsx scripts/nft/update-payment-destination.ts",
    "nft:enable-free-fallback": "tsx scripts/nft/enable-free-fallback.ts"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/mpl-core-candy-machine": "^0.3.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.5.1",
    "@metaplex-foundation/umi-uploader-irys": "^1.5.0",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
