# Copy this file to ".env" and fill in your Supabase project values.
# Both are safe to expose in the browser (the anon / publishable key is public).
# Find them in: Supabase dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Solana devnet RPC used by the "Gorb NFT Mint" app and the scripts/nft/ deploy scripts.
# Public devnet RPC is fine to start; swap in a free Helius/QuickNode devnet URL if you hit rate limits.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
